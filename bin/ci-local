#!/usr/bin/env bash
# Run the GitHub Actions jobs locally in Docker before pushing.
#
#   bin/ci-local              rubocop + rspec (fast mode, used by .githooks/pre-push)
#   bin/ci-local --docker     also build the production image (docker-image-ghcr.yml)
#   bin/ci-local --only rubocop|rspec|docker   run a single job
#   bin/ci-local --rspec-args "spec/models"    pass paths/options to rspec
#   bin/ci-local --commit <sha>               fail unless the clean work tree is <sha>
#   bin/ci-local --check-passed <sha> <job>... exit 0 if those jobs already passed
#                                             for <sha> (used by .githooks/pre-push)
#
# Everything runs in containers as the calling user (no root-owned files in
# the tree). The test image matches the runners: ubuntu-26.04, GCC 15 and the
# ruby/setup-ruby Ruby build. Gems are installed into vendor/bundle as in CI
# (backed by $CI_LOCAL_CACHE, default ~/.cache/chaskiq-ci-local, as is the yarn
# cache); node_modules lives in the work tree.
# Postgres/redis versions match docker-compose.yml and .github/workflows/ruby.yml.
# Exit code is non-zero if any job fails.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

RUBY_VERSION=$(tr -d '[:space:]' < .ruby-version)
# Keep in sync with node-version in .github/workflows/ruby.yml
NODE_MAJOR=26
PG_IMAGE=postgres:14-alpine
REDIS_IMAGE=redis:8.10-alpine
# The runners' OS (ubuntu-latest) and the ruby/setup-ruby build of
# .ruby-version for it: https://github.com/ruby/ruby-builder/releases
RUNNER_OS=ubuntu-26.04
RUBY_BUILDER_VERSION=3.3.14
RUBY_BUILDER_SHA256=dc801dd9014d637602dd2047ae024ee980d357834935e6db823487cd188e2cca
# Keep in sync with the env of .github/workflows/ruby.yml and rubocop-analysis.yml
SCOUT_APM_BUILD_FLAGS="--with-cflags=-std=gnu17"
TEST_IMAGE="chaskiq-ci-local:ruby-$RUBY_VERSION-$RUNNER_OS"
CACHE=${CI_LOCAL_CACHE:-$HOME/.cache/chaskiq-ci-local}
UIDGID="$(id -u):$(id -g)"

jobs=(rubocop rspec)
rspec_args=""
expect_commit=""
check_passed=""
while [ $# -gt 0 ]; do
  case "$1" in
    --commit) expect_commit=${2:?--commit needs a sha}; shift ;;
    --check-passed) check_passed=${2:?--check-passed needs a sha}; shift 2; break ;;
    --docker) jobs+=(docker) ;;
    --only) jobs=("${2:?--only needs a job name}"); shift ;;
    --rspec-args) rspec_args=${2:?--rspec-args needs a value}; shift ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

log() { printf '\n==> %s\n' "$*"; }

build_test_image() {
  if [ "$RUBY_VERSION" != "$RUBY_BUILDER_VERSION" ]; then
    echo ".ruby-version is $RUBY_VERSION, but bin/ci-local pins the ruby-builder build of $RUBY_BUILDER_VERSION." >&2
    echo "Update RUBY_BUILDER_VERSION and RUBY_BUILDER_SHA256 (digest of ruby-<ver>-$RUNNER_OS-x64.tar.gz" >&2
    echo "from https://github.com/ruby/ruby-builder/releases/tag/ruby-<ver>)." >&2
    return 1
  fi
  log "test image $TEST_IMAGE ($RUNNER_OS, ruby-builder $RUBY_VERSION)"
  docker build -q -t "$TEST_IMAGE" --build-arg "RUBY_VERSION=$RUBY_VERSION" \
    --build-arg "RUBY_SHA256=$RUBY_BUILDER_SHA256" --build-arg "RUNNER_OS=$RUNNER_OS" \
    --build-arg "NODE_MAJOR=$NODE_MAJOR" - <<'EOF' >/dev/null
# Same OS, compiler (GCC 15, C23 by default) and Ruby binary as the GitHub
# runners: ruby/setup-ruby installs this very ruby-builder tarball there.
FROM ubuntu:26.04
ARG RUBY_VERSION RUBY_SHA256 RUNNER_OS NODE_MAJOR
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends \
    build-essential git pkg-config libpq-dev postgresql-client libyaml-dev zlib1g-dev \
    libssl-dev libffi-dev libgmp-dev libvips42t64 imagemagick curl ca-certificates gnupg \
    shared-mime-info tzdata \
 && curl -fsSLo /tmp/ruby.tgz \
    "https://github.com/ruby/ruby-builder/releases/download/ruby-${RUBY_VERSION}/ruby-${RUBY_VERSION}-${RUNNER_OS}-x64.tar.gz" \
 && echo "${RUBY_SHA256}  /tmp/ruby.tgz" | sha256sum -c - \
 && install -d "/opt/hostedtoolcache/Ruby/${RUBY_VERSION}" \
 && tar -xzf /tmp/ruby.tgz -C "/opt/hostedtoolcache/Ruby/${RUBY_VERSION}" && rm /tmp/ruby.tgz \
 && install -d /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
 && apt-get update -qq && apt-get install -yq --no-install-recommends nodejs \
 && npm install -g yarn@1.22.22 ts-node@10.9.2 \
 && rm -rf /var/lib/apt/lists/* /root/.npm
ENV PATH=/opt/hostedtoolcache/Ruby/${RUBY_VERSION}/x64/bin:$PATH
ENV LANG=C.UTF-8 BUNDLE_JOBS=8 BUNDLE_RETRY=3 HOME=/tmp
EOF
}

# Run a command in the test image as the calling user, tree mounted at /app.
# Gems go to /app/vendor/bundle like setup-ruby's bundler-cache, so RuboCop and
# friends see them inside the tree exactly as in CI; the directory itself is a
# bind mount of the host cache (the work tree only gets an empty, gitignored
# vendor/bundle, created here so Docker does not create it as root).
in_ruby() {
  mkdir -p "$CACHE/bundle-$RUNNER_OS" "$CACHE/yarn" "$ROOT/vendor/bundle"
  docker run --rm --init --label "chaskiq-ci-local=$RUN_ID" --user "$UIDGID" \
    -e HOME=/tmp -e BUNDLE_PATH=/app/vendor/bundle -e BUNDLE_FROZEN=true -e YARN_CACHE_FOLDER=/yarn \
    -e BUNDLE_BUILD__SCOUT_APM="$SCOUT_APM_BUILD_FLAGS" \
    -v "$ROOT:/app" -v "$CACHE/bundle-$RUNNER_OS:/app/vendor/bundle" -v "$CACHE/yarn:/yarn" -w /app \
    "$@"
}

run_rubocop() {
  log "rubocop"
  # Same contract as rubocop-analysis.yml: any offense fails; the old backlog is
  # in .rubocop_todo.yml.
  in_ruby "$TEST_IMAGE" bundle install --quiet || { echo "bundle install failed" >&2; return 1; }
  # CI lints a fresh checkout plus the gems in vendor/bundle: drop other
  # untracked files from RuboCop's target list (its own excludes are already
  # applied by --list-target-files).
  # Per-run lists (parallel runs must not share them); -z keeps non-ASCII names
  # unquoted, as RuboCop prints them.
  local all=$RUN_TMP/rubocop-targets.all list=$RUN_TMP/rubocop-targets.txt
  in_ruby "$TEST_IMAGE" bundle exec rubocop --list-target-files > "$all" \
    || { echo "rubocop --list-target-files failed" >&2; return 2; }
  { git ls-files -z | tr '\0' '\n'; grep '^vendor/bundle/' "$all" || :; } \
    | grep -Fxf - "$all" > "$list" || :
  local skipped
  skipped=$(grep -vFxf "$list" "$all" || :)
  [ -z "$skipped" ] || printf 'rubocop: skipping untracked files (not in a CI checkout):\n%s\n' "$skipped"
  local rc=0
  in_ruby -e TARGETS="$list" "$TEST_IMAGE" bash -c 'mapfile -t files < "$TARGETS"
    exec bundle exec rubocop --force-exclusion --format progress --format offenses \
      --format simple --out tmp/rubocop.txt "${files[@]}"' || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "rubocop: clean"
    return 0
  fi
  echo "rubocop: exit $rc (1 = offenses, 2+ = RuboCop error; details in tmp/rubocop.txt)" >&2
  return "$rc"
}

run_rspec() {
  # Network and containers are removed by cleanup() (EXIT/INT/TERM trap).
  local id=$RUN_ID
  log "rspec (services: $PG_IMAGE, $REDIS_IMAGE)"
  docker network create "$id" >/dev/null
  docker run -d --label "chaskiq-ci-local=$RUN_ID" --name "$id-pg" --network "$id" --network-alias pg \
    -e POSTGRES_PASSWORD=postgres --tmpfs /var/lib/postgresql/data "$PG_IMAGE" >/dev/null
  docker run -d --label "chaskiq-ci-local=$RUN_ID" --name "$id-redis" --network "$id" --network-alias redis "$REDIS_IMAGE" >/dev/null
  local ready=""
  for _ in $(seq 1 60); do
    if docker exec "$id-pg" pg_isready -U postgres -h 127.0.0.1 >/dev/null 2>&1; then ready=1; break; fi
    sleep 1
  done
  [ -n "$ready" ] || { echo "postgres did not become ready" >&2; return 1; }
  in_ruby --network "$id" \
    -e RAILS_ENV=test \
    -e DATABASE_URL=postgres://postgres:postgres@pg:5432/test \
    -e REDIS_URL=redis://redis:6379/0 \
    -e RSPEC_ARGS="$rspec_args" \
    "$TEST_IMAGE" bash -c '
      set -e
      bundle install --quiet
      yarn install --frozen-lockfile --non-interactive --silent
      bin/rails db:prepare >/dev/null
      bundle exec rspec $RSPEC_ARGS'
}

run_docker() {
  log "docker build (production image, as in docker-image-ghcr.yml)"
  docker build \
    --build-arg APP_ENV=production \
    --build-arg NODE_ENV=production \
    --build-arg "RUBY_VERSION=$RUBY_VERSION" \
    --build-arg PG_MAJOR=15 \
    --build-arg NODE_MAJOR=26 \
    --build-arg YARN_VERSION=1.13.0 \
    --build-arg BUNDLER_VERSION=2.4.10 \
    -t chaskiq-ci-local:prod .
}

# The commit under test: HEAD, or empty if tracked files have uncommitted changes.
tested_commit() {
  git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null && git rev-parse -q --verify HEAD 2>/dev/null || :
}

# HEAD if the tree is completely clean: no tracked changes, no untracked files,
# and ignored files only in the generated/cache paths below (an ignored
# .env*, .rspec-local, config/*.local etc. could change the run). Else empty.
recordable_commit() {
  local entry
  while IFS= read -r -d '' entry; do
    case "$entry" in
      '!! '*)
        case "${entry#!! }" in
          log/*|tmp/*|node_modules/*|vendor/bundle/*|storage/*|coverage/*|public/assets/*|public/packs/*|public/packs-test/*|app/assets/builds/*) continue ;;
        esac ;;
    esac
    return 0
  done < <(git status --porcelain=v1 -z --ignored=matching --untracked-files=normal)
  tested_commit
}

# Passed jobs are recorded in $STAMPS (read through --check-passed by
# .githooks/pre-push) under a key of the commit, bin/ci-local itself and the
# test image, and only for a recordable tree that did not change during the run;
# rspec only for a full run (no --rspec-args).
STAMPS=tmp/ci-local/passed
record_key() {  # <commit> <job>
  local image=-
  # Content of the test image (layers + env). Not .Id: with the containerd
  # store every rebuild gets a new id (provenance), even when fully cached.
  [ "$2" = docker ] || image=$(docker image inspect -f '{{json .RootFS.Layers}}{{json .Config.Env}}' "$TEST_IMAGE" 2>/dev/null \
    | sha256sum | cut -c1-16)
  echo "$1 $(sha256sum "$ROOT/bin/ci-local" | cut -d' ' -f1) $image $2"
}

if [ -n "$check_passed" ]; then
  [ $# -gt 0 ] || { echo "--check-passed needs job names" >&2; exit 2; }
  [ "$(recordable_commit)" = "$check_passed" ] || exit 1
  for j in "$@"; do
    grep -qxF "$(record_key "$check_passed" "$j")" "$STAMPS" 2>/dev/null || exit 1
  done
  exit 0
fi

record_at_start=$(recordable_commit)
check_expected() {  # <when>
  [ -z "$expect_commit" ] && return 0
  local now
  now=$(tested_commit)
  if [ "$now" != "$expect_commit" ]; then
    echo "ci-local: $1, the work tree is ${now:-dirty (uncommitted tracked changes)}, not the expected commit $expect_commit" >&2
    exit 1
  fi
}
check_expected "before the run"

# Everything a run creates is named/labelled with RUN_ID; cleanup() removes it
# on any exit: success, failure, error, Ctrl-C or SIGTERM. Idempotent.
RUN_ID="chaskiq-ci-local-$$"
mkdir -p tmp
RUN_TMP=$(mktemp -d tmp/ci-local-run.XXXXXX)
job_pid=""
cleanup() {
  [ -z "$job_pid" ] || kill -TERM "$job_pid" 2>/dev/null || :
  local ids
  ids=$(docker ps -aq --filter "label=chaskiq-ci-local=$RUN_ID" 2>/dev/null || :)
  [ -z "$ids" ] || docker rm -f $ids >/dev/null 2>&1 || :
  docker network rm "$RUN_ID" >/dev/null 2>&1 || :
  rm -rf "$RUN_TMP"
}
trap cleanup EXIT
trap 'echo "ci-local: interrupted" >&2; exit 130' INT
trap 'echo "ci-local: terminated" >&2; exit 143' TERM

needs_test_image=""
for j in "${jobs[@]}"; do
  case "$j" in
    rubocop|rspec) needs_test_image=1 ;;
    docker) ;;
    *) echo "unknown job: $j (rubocop|rspec|docker)" >&2; exit 2 ;;
  esac
done
[ -z "$needs_test_image" ] || build_test_image

failed=()
for j in "${jobs[@]}"; do
  # In the background + wait, so a signal to this shell is handled at once
  # instead of after the job finishes.
  ( "run_$j" ) & job_pid=$!
  job_rc=0
  wait "$job_pid" || job_rc=$?
  job_pid=""
  if [ "$job_rc" -eq 0 ]; then
    echo "--> $j: OK"
  else
    echo "--> $j: FAILED" >&2
    failed+=("$j")
  fi
done

if [ ${#failed[@]} -gt 0 ]; then
  printf '\nci-local FAILED: %s\n' "${failed[*]}" >&2
  exit 1
fi
check_expected "after the run"
if [ -n "$record_at_start" ] && [ "$(recordable_commit)" = "$record_at_start" ]; then
  mkdir -p "$(dirname "$STAMPS")"
  (
    flock 9
    for j in "${jobs[@]}"; do
      [ "$j" = rspec ] && [ -n "$rspec_args" ] && continue
      record_key "$record_at_start" "$j" >> "$STAMPS"
    done
  ) 9>> "$STAMPS.lock"
else
  echo "ci-local: result not recorded for the pre-push hook (tree not completely clean, see git status --ignored)"
fi
printf '\nci-local: all jobs passed (%s)\n' "${jobs[*]}"
