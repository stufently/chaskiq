#!/usr/bin/env bash
# Run the GitHub Actions jobs locally in Docker before pushing.
#
#   bin/ci-local              rubocop + rspec (fast mode, used by .githooks/pre-push)
#   bin/ci-local --docker     also build the production image (docker-image-ghcr.yml)
#   bin/ci-local --only rubocop|rspec|docker   run a single job
#   bin/ci-local --rspec-args "spec/models"    pass paths/options to rspec
#
# Everything runs in containers as the calling user (no root-owned files in
# the tree). Gems and the yarn cache live in $CI_LOCAL_CACHE
# (default ~/.cache/chaskiq-ci-local), node_modules in the work tree.
# Postgres/redis versions match docker-compose.yml and .github/workflows/ruby.yml.
# Exit code is non-zero if any job fails.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

RUBY_VERSION=$(tr -d '[:space:]' < .ruby-version)
# Keep in sync with node-version in .github/workflows/ruby.yml
NODE_MAJOR=26
PG_IMAGE=postgres:14-alpine
REDIS_IMAGE=redis:8.10-alpine
TEST_IMAGE="chaskiq-ci-local:ruby-$RUBY_VERSION"
CACHE=${CI_LOCAL_CACHE:-$HOME/.cache/chaskiq-ci-local}
UIDGID="$(id -u):$(id -g)"

jobs=(rubocop rspec)
rspec_args=""
while [ $# -gt 0 ]; do
  case "$1" in
    --docker) jobs+=(docker) ;;
    --only) jobs=("${2:?--only needs a job name}"); shift ;;
    --rspec-args) rspec_args=${2:?--rspec-args needs a value}; shift ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

log() { printf '\n==> %s\n' "$*"; }

build_test_image() {
  log "test image $TEST_IMAGE"
  docker build -q -t "$TEST_IMAGE" --build-arg "RUBY_VERSION=$RUBY_VERSION" \
    --build-arg "NODE_MAJOR=$NODE_MAJOR" - <<'EOF' >/dev/null
ARG RUBY_VERSION
FROM ruby:${RUBY_VERSION}-slim-trixie
ARG NODE_MAJOR
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends \
    build-essential git pkg-config libpq-dev postgresql-client libyaml-dev zlib1g-dev \
    libvips42 imagemagick curl ca-certificates gnupg shared-mime-info \
 && install -d /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
 && apt-get update -qq && apt-get install -yq --no-install-recommends nodejs \
 && npm install -g yarn@1.22.22 ts-node@10.9.2 \
 && rm -rf /var/lib/apt/lists/* /root/.npm
ENV LANG=C.UTF-8 BUNDLE_JOBS=8 BUNDLE_RETRY=3 HOME=/tmp
EOF
}

# Run a command in the test image as the calling user, tree mounted at /app.
in_ruby() {
  mkdir -p "$CACHE/bundle" "$CACHE/yarn"
  docker run --rm --user "$UIDGID" \
    -e HOME=/tmp -e BUNDLE_PATH=/bundle -e BUNDLE_FROZEN=true -e YARN_CACHE_FOLDER=/yarn \
    -v "$CACHE/bundle:/bundle" -v "$CACHE/yarn:/yarn" -v "$ROOT:/app" -w /app \
    "$@"
}

run_rubocop() {
  log "rubocop"
  # Same contract as rubocop-analysis.yml: offenses (exit 1) are reported, not fatal
  # (the tree has a known backlog); a RuboCop error/crash (exit 2+) fails the job.
  local rc=0
  in_ruby "$TEST_IMAGE" bash -c 'bundle install --quiet && bundle exec rubocop --format offenses --format progress --out tmp/rubocop.txt' || rc=$?
  if [ "$rc" -le 1 ]; then
    echo "rubocop: exit $rc (offenses are not fatal, full list in tmp/rubocop.txt)"
    return 0
  fi
  echo "rubocop: error, exit $rc" >&2
  return "$rc"
}

run_rspec() {
  # global, not local: the EXIT trap runs after this function has returned
  id="chaskiq-ci-local-$$"
  cleanup() {
    docker rm -f "$id-pg" "$id-redis" >/dev/null 2>&1 || :
    docker network rm "$id" >/dev/null 2>&1 || :
  }
  trap cleanup EXIT
  log "rspec (services: $PG_IMAGE, $REDIS_IMAGE)"
  docker network create "$id" >/dev/null
  docker run -d --name "$id-pg" --network "$id" --network-alias pg \
    -e POSTGRES_PASSWORD=postgres --tmpfs /var/lib/postgresql/data "$PG_IMAGE" >/dev/null
  docker run -d --name "$id-redis" --network "$id" --network-alias redis "$REDIS_IMAGE" >/dev/null
  local ready=""
  for _ in $(seq 1 60); do
    if docker exec "$id-pg" pg_isready -U postgres -h 127.0.0.1 >/dev/null 2>&1; then ready=1; break; fi
    sleep 1
  done
  [ -n "$ready" ] || { echo "postgres did not become ready" >&2; return 1; }
  in_ruby --network "$id" \
    -e RAILS_ENV=test \
    -e DATABASE_URL=postgres://postgres:postgres@pg:5432/test \
    -e REDIS_URL=redis://redis:6379/0 \
    -e RSPEC_ARGS="$rspec_args" \
    "$TEST_IMAGE" bash -c '
      set -e
      bundle install --quiet
      yarn install --frozen-lockfile --non-interactive --silent
      bin/rails db:prepare >/dev/null
      bundle exec rspec $RSPEC_ARGS'
}

run_docker() {
  log "docker build (production image, as in docker-image-ghcr.yml)"
  docker build \
    --build-arg APP_ENV=production \
    --build-arg NODE_ENV=production \
    --build-arg "RUBY_VERSION=$RUBY_VERSION" \
    --build-arg PG_MAJOR=15 \
    --build-arg NODE_MAJOR=16 \
    --build-arg YARN_VERSION=1.13.0 \
    --build-arg BUNDLER_VERSION=2.4.10 \
    -t chaskiq-ci-local:prod .
}

needs_test_image=""
for j in "${jobs[@]}"; do
  case "$j" in
    rubocop|rspec) needs_test_image=1 ;;
    docker) ;;
    *) echo "unknown job: $j (rubocop|rspec|docker)" >&2; exit 2 ;;
  esac
done
[ -z "$needs_test_image" ] || build_test_image

failed=()
for j in "${jobs[@]}"; do
  if ( "run_$j" ); then
    echo "--> $j: OK"
  else
    echo "--> $j: FAILED" >&2
    failed+=("$j")
  fi
done

if [ ${#failed[@]} -gt 0 ]; then
  printf '\nci-local FAILED: %s\n' "${failed[*]}" >&2
  exit 1
fi
printf '\nci-local: all jobs passed (%s)\n' "${jobs[*]}"
