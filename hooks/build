#!/usr/bin/env sh

docker build --build-arg APP_ENV=production \
             --build-arg RUBY_VERSION=4.0.10 \
             --build-arg PG_MAJOR=15 \
             --build-arg NODE_MAJOR=22 \
             --build-arg YARN_VERSION=1.13.0 \
             --build-arg BUNDLER_VERSION=4.0.20 \
             -f $DOCKERFILE_PATH \
             -t $IMAGE_NAME \
             .

