# Test runner image for chaskiq milestone fork-updates-m1.
# System deps only; gems live in a bind-mounted BUNDLE_PATH, node_modules in the clone.
# ts-node is installed globally because spec/support/graphql_queries.rb shells out to npx ts-node (CI does the same).
FROM ruby:3.3.5-slim-bookworm
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends \
    build-essential git pkg-config libpq-dev postgresql-client libyaml-dev zlib1g-dev \
    libvips42 imagemagick curl ca-certificates shared-mime-info nodejs npm \
 && npm install -g ts-node@10.9.2 \
 && rm -rf /var/lib/apt/lists/* /root/.npm
ENV LANG=C.UTF-8 BUNDLE_JOBS=16 BUNDLE_RETRY=3 HOME=/tmp
